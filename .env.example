# Exemplo para desenvolvimento. PowerShell nao carrega este arquivo automaticamente.
# Gere um AUTH_SECRET novo, aleatorio, com pelo menos 32 bytes; nunca use este exemplo.
AUTH_SECRET=<GERAR_SEGREDO_LOCAL_DE_32_BYTES_OU_MAIS>
INITIAL_ADMIN_USERNAME=admin_dev
INITIAL_ADMIN_PASSWORD=<DEFINIR_SENHA_LOCAL_FORTE>
INITIAL_ADMIN_NAME=Administrador de desenvolvimento
# Definidos pelos scripts dev a partir de -DevRoot; nao aponte para dados clinicos.
BACKEND_DATABASE_PATH=<DEV_ROOT>/backend/clinica_dev.db
BACKEND_DATA_DIR=<DEV_ROOT>/backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false
# CLINICA_RUNTIME_ROOT, CLINICA_OPERATIONAL_POINTER e demais variaveis
# operacionais nao sao necessarias para desenvolvimento normal.
